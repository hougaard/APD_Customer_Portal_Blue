<!DOCTYPE html>
<html lang="en">
<head>
  <title>Project Details - Customer Portal</title>
  <?parse('portal-head')?>
</head>
<body>
  <?parse('portal-header')?>

  <?table(Job)?>
  <?get(Job,Parm('jobno'))?>

  <section class="section">
    <div class="container">
      <div class="is-flex is-justify-content-space-between is-align-items-center mb-5">
        <div>
          <h1 class="page-title"><i class="fas fa-project-diagram mr-2" style="color:var(--accent-light);"></i>Project <?field(Job,"No.")?></h1>
          <p class="page-subtitle"><?field(Job,Description)?></p>
        </div>
        <a href="<?action('PROJECTS')?>" class="button btn-ghost">
          <span class="icon"><i class="fas fa-arrow-left"></i></span><span>Back to Projects</span>
        </a>
      </div>

      <!-- Project Info Cards -->
      <div class="columns mb-5">
        <div class="column is-3">
          <div class="dark-card p-4 has-text-centered">
            <p style="color:var(--text-muted);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Status</p>
            <p class="mt-2">
              <?if(Job,Status,'=','2')?>
                <span class="tag is-medium" style="background:rgba(34,197,94,0.15);color:#4ade80;border:1px solid rgba(34,197,94,0.3);">Open</span>
              <?endif?>
              <?if(Job,Status,'=','0')?>
                <span class="tag is-medium" style="background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.3);">Planning</span>
              <?endif?>
              <?if(Job,Status,'=','1')?>
                <span class="tag is-medium" style="background:rgba(234,179,8,0.15);color:#facc15;border:1px solid rgba(234,179,8,0.3);">Quote</span>
              <?endif?>
              <?if(Job,Status,'=','3')?>
                <span class="tag is-medium" style="background:rgba(100,116,139,0.15);color:#94a3b8;border:1px solid rgba(100,116,139,0.3);">Completed</span>
              <?endif?>
            </p>
          </div>
        </div>
        <div class="column is-3">
          <div class="dark-card p-4 has-text-centered">
            <p style="color:var(--text-muted);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Starting Date</p>
            <p class="mt-2" style="color:var(--text-primary);font-size:1.1rem;font-weight:600;"><?field(Job,"Starting Date")?></p>
          </div>
        </div>
        <div class="column is-3">
          <div class="dark-card p-4 has-text-centered">
            <p style="color:var(--text-muted);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Ending Date</p>
            <p class="mt-2" style="color:var(--text-primary);font-size:1.1rem;font-weight:600;"><?field(Job,"Ending Date")?></p>
          </div>
        </div>
        <div class="column is-3">
          <div class="dark-card p-4 has-text-centered">
            <p style="color:var(--text-muted);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;">Person Responsible</p>
            <p class="mt-2" style="color:var(--text-primary);font-size:1.1rem;font-weight:600;"><?field(Job,"Person Responsible")?></p>
          </div>
        </div>
      </div>

      <?close(Job)?>

      <!-- Job Tasks -->
      <?table("Job Task")?>
      <?filter("Job Task","Job No.",Parm('jobno'))?>

      <div class="dark-card p-5">
        <h2 style="color:var(--text-primary);font-size:1.3rem;font-weight:700;margin-bottom:1.2rem;">
          <i class="fas fa-tasks mr-2" style="color:var(--accent-light);"></i>Project Tasks
        </h2>

        <?if("Job Task",'COUNT','>','0')?>
        <div class="table-container">
          <table class="table is-fullwidth dark-table">
            <thead>
              <tr>
                <th>Task No.</th>
                <th>Description</th>
                <th>Task Type</th>
                <th>Start Date</th>
                <th>End Date</th>
              </tr>
            </thead>
            <tbody>
              <?loop("Job Task",'-')?>
              <tr>
                <td style="color:var(--accent-light);font-weight:600;">
                  <?indent("Job Task",Indentation)?><?field("Job Task","Job Task No.")?>
                </td>
                <td>
                  <?indent("Job Task",Indentation)?>
                  <?if("Job Task","Job Task Type",'=','1')?>
                    <strong style="color:var(--text-primary);"><?field("Job Task",Description)?></strong>
                  <?endif?>
                  <?if("Job Task","Job Task Type",'=','0')?>
                    <?field("Job Task",Description)?>
                  <?endif?>
                  <?if("Job Task","Job Task Type",'=','2')?>
                    <strong style="color:var(--text-primary);"><?field("Job Task",Description)?></strong>
                  <?endif?>
                  <?if("Job Task","Job Task Type",'=','3')?>
                    <strong style="color:var(--accent-light);"><?field("Job Task",Description)?></strong>
                  <?endif?>
                  <?if("Job Task","Job Task Type",'=','4')?>
                    <strong style="color:var(--accent-light);"><?field("Job Task",Description)?></strong>
                  <?endif?>
                </td>
                <td>
                  <?if("Job Task","Job Task Type",'=','0')?>
                    <span class="tag" style="background:rgba(34,197,94,0.15);color:#4ade80;border:1px solid rgba(34,197,94,0.3);font-size:0.75rem;">Posting</span>
                  <?endif?>
                  <?if("Job Task","Job Task Type",'=','1')?>
                    <span class="tag" style="background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.3);font-size:0.75rem;">Heading</span>
                  <?endif?>
                  <?if("Job Task","Job Task Type",'=','2')?>
                    <span class="tag" style="background:rgba(168,85,247,0.15);color:#c084fc;border:1px solid rgba(168,85,247,0.3);font-size:0.75rem;">Total</span>
                  <?endif?>
                  <?if("Job Task","Job Task Type",'=','3')?>
                    <span class="tag" style="background:rgba(234,179,8,0.15);color:#facc15;border:1px solid rgba(234,179,8,0.3);font-size:0.75rem;">Begin-Total</span>
                  <?endif?>
                  <?if("Job Task","Job Task Type",'=','4')?>
                    <span class="tag" style="background:rgba(234,179,8,0.15);color:#facc15;border:1px solid rgba(234,179,8,0.3);font-size:0.75rem;">End-Total</span>
                  <?endif?>
                </td>
                <td><?field("Job Task","Start Date")?></td>
                <td><?field("Job Task","End Date")?></td>
              </tr>
              <?endloop("Job Task",1)?>
            </tbody>
          </table>
        </div>
        <?else?>
        <p style="color:var(--text-muted);text-align:center;padding:2rem;"><i class="fas fa-tasks mr-2"></i>No tasks found for this project.</p>
        <?endif?>
      </div>

      <?close("Job Task")?>
    </div>
  </section>

  <?parse('portal-footer')?>
</body>
</html>