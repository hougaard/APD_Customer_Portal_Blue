<!DOCTYPE html>
<html lang="en">
<head>
  <title>Projects - Customer Portal</title>
  <?parse('portal-head')?>
</head>
<body>
  <?parse('portal-header')?>

  <?open(Job)?>

  <section class="section">
    <div class="container">
      <div class="is-flex is-justify-content-space-between is-align-items-center mb-5">
        <div>
          <h1 class="page-title"><i class="fas fa-project-diagram mr-2" style="color:var(--accent-light);"></i>Projects</h1>
          <p class="page-subtitle">View your active and completed projects.</p>
        </div>
        <a href="<?action('DASHBOARD')?>" class="button btn-ghost">
          <span class="icon"><i class="fas fa-arrow-left"></i></span><span>Back to Dashboard</span>
        </a>
      </div>

      <div class="dark-card p-5">
        <?if(Job,'COUNT','>','0')?>
        <div class="table-container">
          <table class="table is-fullwidth dark-table">
            <thead>
              <tr>
                <th>Project No.</th>
                <th>Description</th>
                <th>Status</th>
                <th>Starting Date</th>
                <th>Ending Date</th>
                <th>Person Responsible</th>
                <th class="has-text-centered">Details</th>
              </tr>
            </thead>
            <tbody>
              <?loop(Job,'+')?>
              <tr>
                <td style="color:var(--accent-light);font-weight:600;"><?field(Job,"No.")?></td>
                <td><?field(Job,Description)?> (<?field(job,"Person Responsible")?>) </td>
                <td>
                  <?if(Job,Status,'=','2')?>
                    <span class="tag" style="background:rgba(34,197,94,0.15);color:#4ade80;border:1px solid rgba(34,197,94,0.3);">Open</span>
                  <?endif?>
                  <?if(Job,Status,'=','0')?>
                    <span class="tag" style="background:rgba(59,130,246,0.15);color:#60a5fa;border:1px solid rgba(59,130,246,0.3);">Planning</span>
                  <?endif?>
                  <?if(Job,Status,'=','1')?>
                    <span class="tag" style="background:rgba(234,179,8,0.15);color:#facc15;border:1px solid rgba(234,179,8,0.3);">Quote</span>
                  <?endif?>
                  <?if(Job,Status,'=','3')?>
                    <span class="tag" style="background:rgba(100,116,139,0.15);color:#94a3b8;border:1px solid rgba(100,116,139,0.3);">Completed</span>
                  <?endif?>
                </td>
                <td><?field(Job,"Starting Date")?></td>
                <td><?field(Job,"Ending Date")?></td>
                <td><?field(Job,"Person Responsible")?></td>
                <td class="has-text-centered">
                  <a href="<?action('PROJECTDETAIL',Job)?>" class="button is-small btn-ghost">
                    <span class="icon"><i class="fas fa-eye"></i></span>
                    <span>View</span>
                  </a>
                </td>
              </tr>
              <?endloop(Job,-1)?>
            </tbody>
          </table>
        </div>
        <?else?>
        <p style="color:var(--text-muted);text-align:center;padding:2rem;"><i class="fas fa-project-diagram mr-2"></i>No projects found.</p>
        <?endif?>
      </div>

    </div>
  </section>

  <?close(Job)?>
  <?parse('portal-footer')?>
</body>
</html>