<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.0/css/bulma.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  :root {
    --bg-primary: #0f172a;
    --bg-secondary: #1e293b;
    --bg-card: #243349;
    --bg-card-hover: #2c3d56;
    --border-color: rgba(59,130,246,0.2);
    --accent: #3b82f6;
    --accent-light: #60a5fa;
    --accent-glow: rgba(59,130,246,0.15);
    --text-bright: #f1f5f9;
    --text-normal: #cbd5e1;
    --text-muted: #64748b;
    --danger: #f87171;
    --success: #34d399;
    --warning: #fbbf24;
  }
  html, body {
    min-height: 100vh;
    background: var(--bg-primary) !important;
    color: var(--text-normal);
  }
  body { display: flex; flex-direction: column; padding-top: 52px; }
  .navbar-item.nav-link, .navbar-link.nav-link { color: #94a3b8 !important; }
  .navbar-item.nav-link:hover, .navbar-link.nav-link:hover { color: #e2e8f0 !important; background: rgba(59,130,246,0.1) !important; }
  .navbar-dropdown .navbar-item.nav-link { color: #94a3b8 !important; }
  .navbar-dropdown .navbar-item.nav-link:hover { color: #e2e8f0 !important; background: rgba(59,130,246,0.15) !important; }
  .navbar-divider { background: var(--border-color); }
  .dark-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.3);
  }
  .dark-card:hover { border-color: rgba(59,130,246,0.4); }
  .dark-table {
    background: transparent !important;
    color: var(--text-normal) !important;
  }
  .dark-table th {
    background: rgba(59,130,246,0.1) !important;
    color: var(--accent-light) !important;
    border-bottom: 2px solid var(--border-color) !important;
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.75rem 1rem !important;
  }
  .dark-table td {
    border-bottom: 1px solid rgba(59,130,246,0.08) !important;
    color: var(--text-normal) !important;
    padding: 0.75rem 1rem !important;
    vertical-align: middle;
  }
  .dark-table tr:hover td { background: rgba(59,130,246,0.05) !important; }
  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.5rem;
    transition: all 0.2s;
  }
  .stat-card:hover {
    border-color: rgba(59,130,246,0.5);
    box-shadow: 0 0 20px rgba(59,130,246,0.1);
    transform: translateY(-2px);
  }
  .stat-icon {
    width: 48px; height: 48px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem;
  }
  .btn-primary {
    background: linear-gradient(135deg, #2563eb, #3b82f6) !important;
    color: #fff !important;
    border: none !important;
    font-weight: 600;
    transition: all 0.2s;
  }
  .btn-primary:hover {
    background: linear-gradient(135deg, #1d4ed8, #2563eb) !important;
    box-shadow: 0 0 16px rgba(59,130,246,0.3);
    transform: translateY(-1px);
  }
  .btn-ghost {
    background: transparent !important;
    color: var(--accent-light) !important;
    border: 1px solid var(--border-color) !important;
    font-weight: 500;
  }
  .btn-ghost:hover {
    background: var(--accent-glow) !important;
    border-color: var(--accent) !important;
  }
  .page-title {
    color: var(--text-bright);
    font-weight: 700;
    font-size: 1.75rem;
  }
  .page-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .badge-blue { background: rgba(59,130,246,0.15); color: #60a5fa; }
  .badge-green { background: rgba(52,211,153,0.15); color: #34d399; }
  .badge-red { background: rgba(248,113,113,0.15); color: #f87171; }
  .badge-yellow { background: rgba(251,191,36,0.15); color: #fbbf24; }
  .input, .select select, .textarea {
    background: #0f172a !important;
    color: var(--text-normal) !important;
    border: 1px solid var(--border-color) !important;
  }
  .input:focus, .select select:focus, .textarea:focus {
    border-color: var(--accent) !important;
    box-shadow: 0 0 0 3px rgba(59,130,246,0.15) !important;
  }
  .input::placeholder { color: var(--text-muted) !important; }
  .label { color: var(--text-normal) !important; font-weight: 600; }
  .section { padding: 2rem 1.5rem; }
  .notification.is-info { background: rgba(59,130,246,0.1) !important; color: var(--accent-light) !important; border: 1px solid var(--border-color); }
  a.table-link { color: var(--accent-light); text-decoration: none; }
  a.table-link:hover { color: #93bbfd; text-decoration: underline; }
  .amount-positive { color: var(--success); font-weight: 600; }
  .amount-negative { color: var(--danger); font-weight: 600; }
</style>
<script>
document.addEventListener('DOMContentLoaded',()=>{
  const $burgers=document.querySelectorAll('.navbar-burger');
  $burgers.forEach(el=>{el.addEventListener('click',()=>{
    const target=document.getElementById(el.dataset.target);
    el.classList.toggle('is-active');target.classList.toggle('is-active');
  });});
});
</script>